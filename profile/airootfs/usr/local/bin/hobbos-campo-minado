#!/usr/bin/env python3
"""Campo Minado do hobbOS: o clássico jogo de achar as minas, feito do zero em
GTK 3 com o tabuleiro desenhado em cairo (células em relevo, números coloridos).

Clique esquerdo abre a casa, clique direito marca uma bandeira e clicar num número
com as bandeiras certas em volta abre os vizinhos. O primeiro clique nunca é mina.
"""
import random

import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

NIVEIS = {
    "Iniciante": (9, 9, 10),
    "Intermediário": (16, 16, 40),
    "Avançado": (30, 16, 99),
}
CEL = 22
CORES = {1: (0.0, 0.0, 0.85), 2: (0.0, 0.5, 0.0), 3: (0.85, 0.0, 0.0), 4: (0.0, 0.0, 0.5),
         5: (0.5, 0.0, 0.0), 6: (0.0, 0.5, 0.5), 7: (0.0, 0.0, 0.0), 8: (0.45, 0.45, 0.45)}
CINZA = (0.75, 0.75, 0.75)
CLARO = (1.0, 1.0, 1.0)
ESCURO = (0.5, 0.5, 0.5)


def relevo(cr, x, y, w, h, b, afundado=False):
    """Retângulo com borda em relevo: claro em cima/esquerda, escuro embaixo/direita."""
    c1, c2 = (ESCURO, CLARO) if afundado else (CLARO, ESCURO)
    cr.set_source_rgb(*CINZA)
    cr.rectangle(x, y, w, h)
    cr.fill()
    cr.set_source_rgb(*c1)
    cr.move_to(x, y + h); cr.line_to(x, y); cr.line_to(x + w, y)
    cr.line_to(x + w - b, y + b); cr.line_to(x + b, y + b); cr.line_to(x + b, y + h - b)
    cr.close_path(); cr.fill()
    cr.set_source_rgb(*c2)
    cr.move_to(x + w, y); cr.line_to(x + w, y + h); cr.line_to(x, y + h)
    cr.line_to(x + b, y + h - b); cr.line_to(x + w - b, y + h - b); cr.line_to(x + w - b, y + b)
    cr.close_path(); cr.fill()


class Jogo(Gtk.Window):
    def __init__(self):
        super().__init__(title="Campo Minado")
        self.set_resizable(False)
        self.set_icon_name("applications-games")
        self.connect("destroy", Gtk.main_quit)

        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(caixa)
        caixa.pack_start(self.menu(), False, False, 0)

        topo = Gtk.Box(spacing=0)
        topo.set_border_width(6)
        self.minas_lbl = self.mostrador()
        self.tempo_lbl = self.mostrador()
        self.rosto = Gtk.DrawingArea()
        self.rosto.set_size_request(34, 34)
        self.rosto.connect("draw", self.desenha_rosto)
        botao = Gtk.Button()
        botao.add(self.rosto)
        botao.connect("clicked", lambda *_: self.novo())
        topo.pack_start(self.minas_lbl, False, False, 0)
        centro = Gtk.Box()
        centro.set_center_widget(botao)
        topo.pack_start(centro, True, True, 0)
        topo.pack_end(self.tempo_lbl, False, False, 0)
        caixa.pack_start(topo, False, False, 0)

        self.area = Gtk.DrawingArea()
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK)
        self.area.connect("draw", self.desenha)
        self.area.connect("button-press-event", self.aperta)
        self.area.connect("button-release-event", self.solta)
        quadro = Gtk.Box()
        quadro.set_border_width(6)
        quadro.pack_start(self.area, False, False, 0)
        caixa.pack_start(quadro, False, False, 0)

        css = Gtk.CssProvider()
        css.load_from_data(b".mostrador { background: #000; color: #ff2020; font-family: monospace;"
                           b" font-weight: bold; font-size: 20px; padding: 2px 6px; }")
        Gtk.StyleContext.add_provider_for_screen(self.get_screen(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.nivel = "Iniciante"
        self.timer = None
        self.novo()

    def mostrador(self):
        lbl = Gtk.Label(label="000")
        lbl.get_style_context().add_class("mostrador")
        return lbl

    def menu(self):
        barra = Gtk.MenuBar()
        jogo = Gtk.MenuItem(label="Jogo")
        sub = Gtk.Menu()
        novo = Gtk.MenuItem(label="Novo jogo")
        novo.connect("activate", lambda *_: self.novo())
        sub.append(novo)
        sub.append(Gtk.SeparatorMenuItem())
        grupo = None
        for nome in NIVEIS:
            item = Gtk.RadioMenuItem(label=nome, group=grupo)
            grupo = grupo or item
            item.set_active(nome == "Iniciante")
            item.connect("toggled", self.troca_nivel, nome)
            sub.append(item)
        sub.append(Gtk.SeparatorMenuItem())
        sair = Gtk.MenuItem(label="Sair")
        sair.connect("activate", lambda *_: self.destroy())
        sub.append(sair)
        jogo.set_submenu(sub)
        barra.append(jogo)
        return barra

    def troca_nivel(self, item, nome):
        if item.get_active():
            self.nivel = nome
            self.novo()

    def novo(self):
        self.w, self.h, self.total = NIVEIS[self.nivel]
        self.minas = set()
        self.abertas = set()
        self.bandeiras = set()
        self.estado = "novo"  # novo, jogando, ganhou, perdeu
        self.explodiu = None
        self.apertando = False
        self.segundos = 0
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        self.area.set_size_request(self.w * CEL, self.h * CEL)
        self.atualiza_mostradores()
        self.area.queue_draw()
        self.rosto.queue_draw()
        self.resize(1, 1)

    def vizinhos(self, x, y):
        for dx in (-1, 0, 1):
            for dy in (-1, 0, 1):
                nx, ny = x + dx, y + dy
                if (dx or dy) and 0 <= nx < self.w and 0 <= ny < self.h:
                    yield nx, ny

    def conta(self, x, y):
        return sum((v in self.minas) for v in self.vizinhos(x, y))

    def espalha_minas(self, x, y):
        livres = {(x, y), *self.vizinhos(x, y)}
        casas = [(i, j) for i in range(self.w) for j in range(self.h) if (i, j) not in livres]
        self.minas = set(random.sample(casas, self.total))
        self.estado = "jogando"
        self.timer = GLib.timeout_add_seconds(1, self.tique)

    def tique(self):
        if self.estado != "jogando":
            return False
        self.segundos = min(999, self.segundos + 1)
        self.atualiza_mostradores()
        return True

    def atualiza_mostradores(self):
        resto = self.total - len(self.bandeiras)
        self.minas_lbl.set_text(f"{resto:03d}" if resto >= 0 else f"-{-resto:02d}")
        self.tempo_lbl.set_text(f"{self.segundos:03d}")

    def abre(self, x, y):
        pilha = [(x, y)]
        while pilha:
            c = pilha.pop()
            if c in self.abertas or c in self.bandeiras:
                continue
            self.abertas.add(c)
            if c in self.minas:
                self.explodiu = c
                self.estado = "perdeu"
                return
            if self.conta(*c) == 0:
                pilha.extend(self.vizinhos(*c))

    def confere_vitoria(self):
        if self.estado == "jogando" and len(self.abertas) == self.w * self.h - self.total:
            self.estado = "ganhou"
            self.bandeiras = set(self.minas)
            self.atualiza_mostradores()

    def casa(self, ev):
        x, y = int(ev.x // CEL), int(ev.y // CEL)
        return (x, y) if 0 <= x < self.w and 0 <= y < self.h else None

    def aperta(self, area, ev):
        if self.estado in ("ganhou", "perdeu") or ev.type != Gdk.EventType.BUTTON_PRESS:  # ignora duplo clique
            return
        c = self.casa(ev)
        if not c:
            return
        if ev.button == 3 and c not in self.abertas:
            self.bandeiras ^= {c}
            self.atualiza_mostradores()
            area.queue_draw()
        elif ev.button == 1:
            self.apertando = True
            self.rosto.queue_draw()

    def solta(self, area, ev):
        self.apertando = False
        c = self.casa(ev)
        if ev.button == 1 and c and self.estado not in ("ganhou", "perdeu"):
            if self.estado == "novo":
                self.espalha_minas(*c)
            if c in self.abertas:
                n = self.conta(*c)
                viz = list(self.vizinhos(*c))
                if n and sum(v in self.bandeiras for v in viz) == n:
                    for v in viz:
                        self.abre(*v)
            elif c not in self.bandeiras:
                self.abre(*c)
            self.confere_vitoria()
        area.queue_draw()
        self.rosto.queue_draw()

    def desenha(self, area, cr):
        fim = self.estado == "perdeu"
        for x in range(self.w):
            for y in range(self.h):
                px, py, c = x * CEL, y * CEL, (x, y)
                if c in self.abertas or (fim and c in self.minas and c not in self.bandeiras):
                    cr.set_source_rgb(*((1, 0, 0) if c == self.explodiu else CINZA))
                    cr.rectangle(px, py, CEL, CEL)
                    cr.fill()
                    cr.set_source_rgb(*ESCURO)
                    cr.set_line_width(1)
                    cr.rectangle(px + 0.5, py + 0.5, CEL, CEL)
                    cr.stroke()
                    if c in self.minas:
                        self.mina(cr, px, py)
                    else:
                        n = self.conta(x, y)
                        if n:
                            cr.select_font_face("DejaVu Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
                            cr.set_font_size(15)
                            e = cr.text_extents(str(n))
                            cr.set_source_rgb(*CORES[n])
                            cr.move_to(px + (CEL - e.width) / 2 - e.x_bearing, py + (CEL - e.height) / 2 - e.y_bearing)
                            cr.show_text(str(n))
                else:
                    relevo(cr, px, py, CEL, CEL, 3)
                    if c in self.bandeiras:
                        self.bandeira(cr, px, py)
                        if fim and c not in self.minas:
                            cr.set_source_rgb(0.85, 0, 0)
                            cr.set_line_width(2)
                            cr.move_to(px + 5, py + 5); cr.line_to(px + CEL - 5, py + CEL - 5)
                            cr.move_to(px + CEL - 5, py + 5); cr.line_to(px + 5, py + CEL - 5)
                            cr.stroke()

    def mina(self, cr, px, py):
        cx, cy = px + CEL / 2, py + CEL / 2
        cr.set_source_rgb(0, 0, 0)
        cr.set_line_width(2)
        for dx, dy in ((7, 0), (0, 7), (5, 5), (5, -5)):
            cr.move_to(cx - dx, cy - dy); cr.line_to(cx + dx, cy + dy)
        cr.stroke()
        cr.arc(cx, cy, 5, 0, 6.2832)
        cr.fill()
        cr.set_source_rgb(1, 1, 1)
        cr.rectangle(cx - 3, cy - 3, 2, 2)
        cr.fill()

    def bandeira(self, cr, px, py):
        cr.set_source_rgb(0, 0, 0)
        cr.rectangle(px + 6, py + 16, 10, 2)
        cr.rectangle(px + 10, py + 5, 2, 12)
        cr.fill()
        cr.set_source_rgb(0.9, 0, 0)
        cr.move_to(px + 12, py + 4); cr.line_to(px + 5, py + 8); cr.line_to(px + 12, py + 12)
        cr.close_path()
        cr.fill()

    def desenha_rosto(self, area, cr):
        cx, cy, r = 17, 17, 13
        cr.set_source_rgb(1.0, 0.9, 0.1)
        cr.arc(cx, cy, r, 0, 6.2832)
        cr.fill_preserve()
        cr.set_source_rgb(0, 0, 0)
        cr.set_line_width(1.5)
        cr.stroke()
        if self.estado == "ganhou":  # óculos escuros
            cr.rectangle(cx - 9, cy - 5, 7, 4)
            cr.rectangle(cx + 2, cy - 5, 7, 4)
            cr.fill()
            cr.move_to(cx - 2, cy - 4); cr.line_to(cx + 2, cy - 4)
            cr.stroke()
        elif self.estado == "perdeu":  # olhos em X
            for ox in (-5, 5):
                cr.move_to(cx + ox - 2, cy - 6); cr.line_to(cx + ox + 2, cy - 2)
                cr.move_to(cx + ox + 2, cy - 6); cr.line_to(cx + ox - 2, cy - 2)
            cr.stroke()
        else:
            for ox in (-5, 5):
                cr.arc(cx + ox, cy - 4, 1.8, 0, 6.2832)
                cr.fill()
        if self.apertando:  # boca de "oh!"
            cr.arc(cx, cy + 5, 3, 0, 6.2832)
            cr.stroke()
        elif self.estado == "perdeu":
            cr.arc_negative(cx, cy + 10, 5, -0.4, -2.7)
            cr.stroke()
        else:
            cr.arc(cx, cy + 1, 7, 0.5, 2.64)
            cr.stroke()


if __name__ == "__main__":
    Jogo().show_all()
    Gtk.main()
