// fastfetch do hobbOS: logo do disco e um resumo do sistema, ao abrir o terminal
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/hobbos/fastfetch-logo.txt",
    "color": { "1": "white", "2": "yellow", "3": "green", "4": "blue", "5": "red", "6": "cyan", "7": "white" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": " ",
    "key": { "width": 13 },
    "color": { "keys": "yellow", "title": "blue" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "custom", "key": "Sistema", "format": "hobbOS live (base Arch Linux)" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Ligado há" },
    { "type": "packages", "key": "Pacotes" },
    { "type": "de", "key": "Desktop" },
    { "type": "theme", "key": "Tema" },
    { "type": "icons", "key": "Ícones" },
    { "type": "cpu", "key": "Processador" },
    { "type": "gpu", "key": "Vídeo" },
    { "type": "memory", "key": "Memória" },
    { "type": "disk", "key": "Disco" },
    { "type": "localip", "key": "IP local" },
    "break",
    "colors"
  ]
}
