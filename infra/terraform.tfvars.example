# Copie para terraform.tfvars (ignorado pelo Git) e preencha.

os_cloud              = "openstack"
external_network_name = "public"

# Seu IP público (curl ifconfig.me). Cada CIDR é uma string própria.
admin_cidrs = ["203.0.113.10/32"]

ssh_public_key = "ssh-ed25519 AAAA... voce@maquina"

flavor         = "PRI-4-8"
volume_size_gb = 40
volume_type    = null
